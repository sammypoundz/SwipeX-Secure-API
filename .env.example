# ---- Server ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/swipex_secure

# ---- JWT ----
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,https://app.swipex.africa

# ---- Firebase Cloud Messaging ----
# Either paste the service account JSON path, or individual vars:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FCM_ENABLED=true

# ---- Logging ----
LOG_LEVEL=info

# ---- Risk engine ----
RISK_APPROVE_THRESHOLD=35
RISK_CHALLENGE_THRESHOLD=70
