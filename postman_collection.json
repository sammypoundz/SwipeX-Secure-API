{
  "info": {
    "name": "SwipeX Secure API",
    "description": "Transaction authorization & fraud prevention API. Import and set the `accessToken` collection variable from the login response (login sets it automatically via the test script).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "reference", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.accessToken) {",
              "  pm.collectionVariables.set('accessToken', json.accessToken);",
              "}",
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@swipex.africa\",\n  \"password\": \"TestPass123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/login",
        "description": "Returns accessToken + refreshToken. The test script saves accessToken to the collection variable automatically."
      }
    },
    {
      "name": "Refresh token",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/refresh",
        "description": "Requires a valid (non-expired) token; returns a fresh pair."
      }
    },
    {
      "name": "Authorize transaction (clean)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.reference) {",
              "  pm.collectionVariables.set('reference', json.reference);",
              "}",
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 5000,\n  \"currency\": \"NGN\",\n  \"deviceFingerprint\": \"fp-test-abc123\",\n  \"merchantId\": \"mtn-data\",\n  \"homeCountry\": \"NG\",\n  \"locationCountry\": \"NG\",\n  \"hourLocal\": 14\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/transactions/authorize",
        "description": "Low-risk example — typically APPROVED. Saves `reference` for the challenge/lookup requests."
      }
    },
    {
      "name": "Authorize transaction (risky)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.reference) {",
              "  pm.collectionVariables.set('reference', json.reference);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 250000,\n  \"deviceFingerprint\": \"fp-unknown-999\",\n  \"simSwappedRecently\": true,\n  \"locationLatencySuspicious\": true,\n  \"homeCountry\": \"NG\",\n  \"locationCountry\": \"US\",\n  \"hourLocal\": 2\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/transactions/authorize",
        "description": "High-risk example — unknown device, SIM swap, odd hour, foreign location. Typically CHALLENGE or DECLINED."
      }
    },
    {
      "name": "Confirm challenge",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approved\": true\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/transactions/{{reference}}/challenge",
        "description": "Resolve a pending CHALLENGE. Set approved=false to decline it. 409 if already resolved or not a CHALLENGE."
      }
    },
    {
      "name": "Get transaction by reference",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/transactions/{{reference}}",
        "description": "Returns the stored transaction incl. score, decision, reasons and factor breakdown. Scoped to your own customer ID."
      }
    }
  ]
}
